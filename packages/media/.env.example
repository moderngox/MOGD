# Independent Cloudflare R2 credentials for MOGD. Create these in the
# Cloudflare dashboard for a MOGD-owned account/bucket set — never reuse
# SPIDRA's R2 credentials or buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public bucket: approved exercise demonstration videos/thumbnails only.
R2_EXERCISE_MEDIA_BUCKET=mogd-exercise-media
R2_EXERCISE_MEDIA_PUBLIC_BASE_URL=https://media.mogd.example.com

# Private bucket: assessment/progress photos. Never expose a public base
# URL for this bucket — reads only go through short-lived signed URLs.
R2_PRIVATE_PHOTOS_BUCKET=mogd-private-photos
