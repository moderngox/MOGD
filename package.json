{
  "name": "mogd",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @mogd/web dev",
    "dev:admin": "pnpm --filter @mogd/admin dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @mogd/db db:generate",
    "db:migrate": "pnpm --filter @mogd/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
